{
  "version": 1,
  "id": "the-fishbowl",
  "mcpActivations": [
    {
      "id": "firepit"
    }
  ],
  "commands": [
    {
      "group": "Tools",
      "name": "deploy",
      "description": "Builds the working tree and swaps it into the local Fishbowl service, then checks that it answers.",
      "type": "shell",
      "command": "tools/local-host/fishbowl-local",
      "args": ["deploy"],
      "cwd": ".",
      "window": "reuse:fishbowl-host",
      "keepOpenOnError": true,
      "confirm": true
    },
    {
      "group": "Git",
      "name": "repo",
      "description": "Opens this repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/the-fishbowl"
    }
  ]
}
