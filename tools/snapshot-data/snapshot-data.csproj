<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Operator tool; not part of the main product build. -->
    <IsPackable>false</IsPackable>
    <AssemblyName>snapshot-data</AssemblyName>
    <RootNamespace>Fishbowl.Tools.SnapshotData</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.6" />
  </ItemGroup>

</Project>
