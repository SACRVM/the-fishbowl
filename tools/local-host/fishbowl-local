#!/usr/bin/env bash
# Fishbowl on this machine: the one host on the repo's data as a systemd user
# service, a daily snapshot to a backup share, and an app window around the
# web UI. See README.md beside this file.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
self="$repo/tools/local-host/fishbowl-local"
host_dir="$repo/src/Fishbowl.Host"
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
root="$data_home/fishbowl"            # app/, app.old/, browser/
units="$config_home/systemd/user"
conf="$config_home/fishbowl/local.conf"

# The ports `dotnet run` uses (launchSettings.json), so the Google sign-in's
# redirect and the MCP clients' address stay as they are.
urls="https://localhost:7180;http://localhost:7181"
health="http://localhost:7181/api/v1/version"

# Defaults; local.conf overrides them.
FISHBOWL_URL=https://localhost:7180
FISHBOWL_BACKUP_DIR=/mnt/nas/backup/Fishbowl
FISHBOWL_BROWSER=chromium
if [[ -f $conf ]]; then . "$conf"; fi

say() { printf '%s\n' "$*" >&2; }
die() { say "fishbowl-local: $*"; exit 1; }

usage() {
    say "usage: fishbowl-local <command>

  install    write the services, the backup timer and the app launcher
  deploy     build the working tree; if that works, swap it in and restart
  rollback   back to the build before the last deploy (again: undo)
  backup     snapshot the data to FISHBOWL_BACKUP_DIR (what the timer runs)
  app        open the app window (what the launcher runs)"
    exit 2
}

cmd_install() {
    mkdir -p "$units" "$root" "$(dirname "$conf")" \
        "$data_home/applications" "$data_home/icons/hicolor/scalable/apps"

    if [[ ! -f $conf ]]; then
        cat > "$conf" <<EOF
# Fishbowl on this machine (tools/local-host in the repo).

# The address the app window opens. Once Fishbowl runs on its own server,
# put that address here and turn the local host off:
#   systemctl --user disable --now fishbowl.service
FISHBOWL_URL=$FISHBOWL_URL

# Where the daily snapshot goes: another disk than the data's.
FISHBOWL_BACKUP_DIR=$FISHBOWL_BACKUP_DIR

# A Chromium-based browser for the app window.
FISHBOWL_BROWSER=$FISHBOWL_BROWSER
EOF
    fi

    # The working directory is the repo's host folder: the data is its
    # fishbowl-data/, and fishbowl-mods/ links to the UI's sources, so UI
    # edits are live on reload. The program itself is the deployed copy.
    cat > "$units/fishbowl.service" <<EOF
[Unit]
Description=Fishbowl (this machine's host)
Documentation=file://$repo/tools/local-host/README.md

[Service]
WorkingDirectory=$host_dir
ExecStart=$root/app/Fishbowl.Host
Environment=ASPNETCORE_ENVIRONMENT=Development
Environment="ASPNETCORE_URLS=$urls"
SyslogIdentifier=fishbowl
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=default.target
EOF

    cat > "$units/fishbowl-backup.service" <<EOF
[Unit]
Description=Fishbowl: snapshot of the data to the backup share
Documentation=file://$repo/tools/local-host/README.md

[Service]
Type=oneshot
ExecStart=$self backup
Nice=10
IOSchedulingClass=idle
EOF

    # Persistent: a day the machine was off at 03:00 is caught up on the
    # next start.
    cat > "$units/fishbowl-backup.timer" <<EOF
[Unit]
Description=Fishbowl: daily snapshot of the data

[Timer]
OnCalendar=*-*-* 03:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
EOF

    install_icon
    write_launcher "$(window_class)"

    systemctl --user daemon-reload
    systemctl --user enable fishbowl.service
    systemctl --user enable --now fishbowl-backup.timer

    if [[ -d $root/app ]]; then
        say "Installed."
    else
        say "Installed. Build and start the host with: $self deploy"
    fi
}

# The app as installed in the browser profile: one "<url> <app id>" line per
# address it was installed from.
app_ids="$root/app-ids"

# The installed app's id for FISHBOWL_URL; fails when it isn't installed.
installed_app_id() {
    local url id
    [[ -f $app_ids ]] || return 1
    while read -r url id; do
        if [[ $url == "$FISHBOWL_URL" &&
            -d "$root/browser/Default/Web Applications/Manifest Resources/$id" ]]; then
            printf '%s\n' "$id"
            return 0
        fi
    done < "$app_ids"
    return 1
}

# What Chromium names the window, which is how the desktop puts it under the
# launcher's icon. An installed app's is chrome-<app id>-<profile>; a plain
# --app window's chrome-<host>_<path, / as _>-<profile>, without the port.
# --class is ignored for both (Wayland's app id and X11's class).
window_class() {
    local id rest host path=/
    if id=$(installed_app_id); then
        printf 'chrome-%s-Default\n' "$id"
        return
    fi
    rest=${FISHBOWL_URL#*://}
    rest=${rest%%[?#]*}
    host=${rest%%/*}
    host=${host%%:*}
    if [[ $rest == */* ]]; then path=/${rest#*/}; fi
    printf 'chrome-%s_%s-Default\n' "$host" "${path//\//_}"
}

applications="$data_home/applications"

# The logo as the icon "fishbowl", as PNGs in the usual sizes: panels and
# menus draw those more reliably than an SVG. Needs rsvg-convert (librsvg).
install_icon() {
    local icons="$data_home/icons/hicolor" logo="$repo/src/Fishbowl.Data/Resources/img/fishbowl.svg" size
    command -v rsvg-convert >/dev/null || die "rsvg-convert is missing (librsvg)"
    for size in 16 22 24 32 48 64 128 256 512; do
        mkdir -p "$icons/${size}x${size}/apps"
        rsvg-convert -w "$size" -h "$size" "$logo" -o "$icons/${size}x${size}/apps/fishbowl.png"
    done
    rm -f "$icons/scalable/apps/fishbowl.svg"
    touch "$icons"
}

# Plasma's taskbar matches a window's process name against the launchers'
# StartupWMClass before its app id. For every Chromium app window that name
# is "chromium", which Chromium's own launcher claims — so the window would
# sit under Chromium's icon, whatever its app id says. A copy of that launcher
# in the user's applications without that one line hands the match on to the
# app id; Chromium's own windows are still found by their launcher's name.
# Renewed whenever the system's launcher is newer (an update).
shadow_browser_launcher() {
    local exe system copy wrote=1
    exe=$(basename "$(readlink -f "$(command -v "$FISHBOWL_BROWSER")")")
    for system in /usr/share/applications/*.desktop /usr/local/share/applications/*.desktop; do
        [[ -f $system ]] || continue
        grep -qix "StartupWMClass=$exe" "$system" || continue
        copy="$applications/$(basename "$system")"
        if [[ ! -f $copy || $system -nt $copy ]]; then
            mkdir -p "$applications"
            { printf '# %s without its StartupWMClass, by tools/local-host/fishbowl-local:\n' "$system"
              printf '# app windows of this browser would sit under its icon. Delete to undo.\n'
              grep -vix "StartupWMClass=$exe" "$system"; } > "$copy"
            wrote=0
        fi
    done
    return "$wrote"
}

# Rebuilds the desktop's launcher index after launchers changed.
refresh_launchers() {
    if command -v update-desktop-database >/dev/null; then
        update-desktop-database -q "$applications" || true
    fi
    if command -v kbuildsycoca6 >/dev/null; then kbuildsycoca6 >/dev/null 2>&1 || true; fi
}

# The launcher, for the window named $1. Its file is named after the window
# too: the desktop finds a window's launcher by that name first. (Plasma
# would otherwise go by the process: Chromium puts itself in a systemd scope
# named after Chromium, and the window would sit under Chromium's icon.)
# The same name is Chromium's own launcher for the app, which this replaces.
write_launcher() {
    local launcher="$applications/$1.desktop" old
    mkdir -p "$applications"
    # Launchers this wrote for another window name (an earlier address, the
    # plain window before the install).
    for old in "$applications"/*.desktop; do
        if [[ $old != "$launcher" ]] && grep -qxF "Exec=\"$self\" app" "$old" 2>/dev/null; then
            rm -f "$old"
        fi
    done
    cat > "$launcher" <<EOF
[Desktop Entry]
Type=Application
Name=Fishbowl
GenericName=Personal memory
GenericName[de]=Persönliches Gedächtnis
Comment=Notes, mail, calendar and contacts in one place
Comment[de]=Notizen, Mail, Kalender und Kontakte an einem Ort
Exec="$self" app
Icon=fishbowl
Terminal=false
Categories=Office;
StartupNotify=true
StartupWMClass=$1
EOF
    shadow_browser_launcher || true
    refresh_launchers
}

# Restarts the service and waits until it answers.
restart_and_wait() {
    systemctl --user restart fishbowl.service
    for _ in $(seq 60); do
        if curl -fs -o /dev/null --max-time 2 "$health"; then return 0; fi
        sleep 1
    done
    journalctl --user -u fishbowl.service -n 30 --no-pager >&2 || true
    return 1
}

lock_deploys() {
    mkdir -p "$root"
    exec 9>"$root/.deploy.lock"
    flock -n 9 || die "another deploy is running"
}

cmd_deploy() {
    lock_deploys
    local rid
    case $(uname -m) in
        x86_64) rid=linux-x64 ;;
        aarch64|arm64) rid=linux-arm64 ;;
        *) die "no .NET runtime id for $(uname -m)" ;;
    esac

    # Built into its own folder: the running host's files are never
    # written under it, and a failed build leaves it as it is.
    rm -rf "$root/app.new"
    say "Building $(git -C "$repo" describe --tags --always --dirty) …"
    if ! dotnet publish "$host_dir" -c Release -r "$rid" --self-contained false \
            -o "$root/app.new" --nologo -v quiet; then
        rm -rf "$root/app.new"
        die "the build failed; the running host is unchanged"
    fi

    rm -rf "$root/app.old"
    if [[ -d $root/app ]]; then mv "$root/app" "$root/app.old"; fi
    mv "$root/app.new" "$root/app"

    restart_and_wait || die "the new build doesn't answer; '$self rollback' brings the previous one back"
    say "Deployed; Fishbowl answers on ${urls//;/ and }."
}

cmd_rollback() {
    lock_deploys
    [[ -d $root/app.old ]] || die "there is no previous build"
    mv "$root/app" "$root/app.swap"
    mv "$root/app.old" "$root/app"
    mv "$root/app.swap" "$root/app.old"
    restart_and_wait || die "the previous build doesn't answer either"
    say "Back on the previous build ('$self rollback' again undoes it)."
}

# The device a path lives on, without btrfs' [/subvolume] suffix.
device_of() {
    local source
    source=$(findmnt -n -o SOURCE --target "$1" | tail -n 1)
    printf '%s\n' "${source%%\[*}"
}

cmd_backup() {
    local data="$host_dir/fishbowl-data" target=$FISHBOWL_BACKUP_DIR
    [[ -d $data ]] || die "no data at $data"
    # Looking at it mounts an automounted share; a share that's away fails.
    [[ -d $target ]] || die "the backup target isn't reachable: $target"
    # A share that isn't mounted can leave its mount point as an empty folder
    # on the system disk — a snapshot there is no backup.
    if [[ $(device_of "$data") == "$(device_of "$target")" ]]; then
        die "the backup target is on the data's own disk: $target"
    fi
    cd "$repo"
    dotnet run --project tools/snapshot-data -- --data "$data" --out "$target" --quiet
}

cmd_app() {
    case $FISHBOWL_URL in
        http://localhost[:/]*|https://localhost[:/]*|http://localhost|https://localhost)
            # This machine's host: start it if it isn't running, and give it
            # a moment, so the window doesn't open on an error page.
            systemctl --user start fishbowl.service || true
            for _ in $(seq 30); do
                if curl -fs -o /dev/null --max-time 2 "$health"; then break; fi
                sleep 1
            done
            ;;
    esac
    mkdir -p "$root/browser"
    local id class
    if ! id=$(installed_app_id); then
        id=""
        if install_app; then id=$(installed_app_id); fi
    fi
    # A new address (the move to a server) or the first install renames the
    # window, and Chromium writes its own launcher under that name on an
    # install: this one follows.
    class=$(window_class)
    if ! grep -qxF "Exec=\"$self\" app" "$applications/$class.desktop" 2>/dev/null; then
        write_launcher "$class"
    elif shadow_browser_launcher; then
        refresh_launchers
    fi
    # Plasma's taskbar finds a window's launcher through its process first:
    # this hint in the environment, else the command line — which is
    # Chromium's, and would put the window under Chromium's icon.
    export BAMF_DESKTOP_FILE_HINT="$applications/$class.desktop"
    # No extensions in the app's profile: without them the window's title bar
    # (or its controls overlay) loses the extensions' puzzle button.
    local flags=(--user-data-dir="$root/browser" --no-first-run --no-default-browser-check
        --disable-extensions)
    if [[ -n $id ]]; then
        sharpen_window_icon "$id"
        exec "$FISHBOWL_BROWSER" "${flags[@]}" --profile-directory=Default --app-id="$id" "$@"
    fi
    # Not installed (its browser was open, or the address didn't answer):
    # a plain app window, and another try next time.
    exec "$FISHBOWL_BROWSER" "${flags[@]}" --app="$FISHBOWL_URL" "$@"
}

# Whether the app's browser runs: its profile lock is a link to
# <host>-<pid>, and a browser that was killed leaves it behind.
browser_running() {
    local lock
    lock=$(readlink "$root/browser/SingletonLock" 2>/dev/null) || return 1
    kill -0 "${lock##*-}" 2>/dev/null
}

# Chromium gives an app's window the smallest of the app's stored icons from
# 32px up — the 32px one, which the window switcher (Alt+Tab) blows up into
# pixels. The 256px picture under that name gives the window a sharp icon.
# Chromium writes the icons again when the app's change, so this runs before
# every start; while its browser runs, the next start does it.
sharpen_window_icon() {
    local dir="$root/browser/Default/Web Applications/Manifest Resources/$1" icons
    if browser_running; then return 0; fi
    for icons in "$dir/Icons" "$dir/Trusted Icons/Icons"; do
        if [[ -f $icons/256.png ]] && ! cmp -s "$icons/256.png" "$icons/32.png"; then
            cp "$icons/256.png" "$icons/32.png"
        fi
    done
}

# Installs the app from FISHBOWL_URL into the browser profile, once per
# address, and records its id. Fails when that can't be done now.
install_app() {
    local id desktop
    # Its browser runs: the profile is taken.
    if browser_running; then return 1; fi
    id=$(python3 -I "$repo/tools/local-host/install-app.py" \
        "$FISHBOWL_BROWSER" "$root/browser" "$FISHBOWL_URL") || return 1
    printf '%s %s\n' "$FISHBOWL_URL" "$id" >> "$app_ids"
    # Chromium adds launchers of its own: the menu's is replaced under its
    # name (cmd_app), the one on the desktop goes.
    desktop=$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s' "$HOME/Desktop")
    rm -f "$desktop/chrome-$id-Default.desktop"
}

case ${1:-} in
    install) cmd_install ;;
    deploy) cmd_deploy ;;
    rollback) cmd_rollback ;;
    backup) cmd_backup ;;
    app) shift; cmd_app "$@" ;;
    *) usage ;;
esac
