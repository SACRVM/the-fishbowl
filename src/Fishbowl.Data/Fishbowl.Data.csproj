<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fishbowl.Core\Fishbowl.Core.csproj" />
    <ProjectReference Include="..\Fishbowl.Mail\Fishbowl.Mail.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2" />
    <PackageReference Include="Ulid" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- WithCulture="false": a name like sac-data-grid.de.js is a file to
         serve, not a German satellite resource — without it MSBuild moves
         the file into de/Fishbowl.Data.resources.dll, where ResourceProvider
         never looks, and only the dev overlay's disk copy hid the gap. -->
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\**\*.stackdump" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
