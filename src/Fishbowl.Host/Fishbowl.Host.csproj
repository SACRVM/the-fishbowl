<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Fishbowl.Api\Fishbowl.Api.csproj" />
    <ProjectReference Include="..\Fishbowl.Bot.Discord\Fishbowl.Bot.Discord.csproj" />
    <ProjectReference Include="..\Fishbowl.Sync\Fishbowl.Sync.csproj" />
    <ProjectReference Include="..\Fishbowl.Scheduler\Fishbowl.Scheduler.csproj" />
    <ProjectReference Include="..\Fishbowl.Scripting\Fishbowl.Scripting.csproj" />
    <ProjectReference Include="..\Fishbowl.Mcp\Fishbowl.Mcp.csproj" />
    <ProjectReference Include="..\Fishbowl.Search\Fishbowl.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Husky.Client" Version="0.1.4" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="LettuceEncrypt" Version="1.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Retro.Crt" Version="0.8.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1c355ec5-18cc-48f6-a980-8180ba39bfb9</UserSecretsId>
    <!-- Runtime data folders. fishbowl-mods/ contains junctions/symlinks to
         Fishbowl.Data/Resources for the dev mod-overlay workflow; without
         this exclusion, Windows' reparse-point trust policy causes the
         SDK's default-item globber to fail with MSB3552 on any build. -->
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);fishbowl-data/**;fishbowl-mods/**;fishbowl-backups/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>

</Project>
