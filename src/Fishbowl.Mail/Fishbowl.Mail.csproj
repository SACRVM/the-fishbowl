<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Multi-account IMAP/SMTP mailbox library (iCloud, Gmail, IONOS, custom) built on MailKit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- MailKit (MimeKit) brings 10.0.0, which has known vulnerabilities
         (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate): the fixed
         one, for every project above this library. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fishbowl.Mail.Tests" />
  </ItemGroup>

</Project>
